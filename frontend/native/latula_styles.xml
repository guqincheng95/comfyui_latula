<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#080e18</item>
        <item name="colorPrimaryDark">#080e18</item>
        <item name="colorAccent">#e9b861</item>
        <item name="android:windowBackground">#080e18</item>
        <item name="android:statusBarColor">#080e18</item>
        <item name="android:navigationBarColor">#080e18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080e18</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/latula_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">#080e18</item>
        <item name="android:navigationBarColor">#080e18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
